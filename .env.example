# Copy to .env and fill in the two REQUIRED values. Never commit .env.
# Use letters and digits only for passwords (they are interpolated into SQL at init).

# --- REQUIRED ---------------------------------------------------------------
GROQ_API_KEY=
# Shared secret between the CodeIgniter portal and the Python API (any long random string)
ATLAS_API_KEY=change-me-to-a-long-random-string

# --- LLM (Groq) -------------------------------------------------------------
LLM_MODEL=llama-3.3-70b-versatile
LLM_ROUTER_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=12
MAX_TOKENS_PER_REQUEST=6000
MAX_OUTPUT_TOKENS=700

# --- Behaviour --------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.6
REQUEST_TIMEOUT_S=28
CACHE_TTL_S=3600
SQL_ROW_LIMIT=50
SQL_TIMEOUT_MS=2000
LOG_LEVEL=INFO

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_APP_USER=atlas_app
MYSQL_APP_PASSWORD=apppass123
MYSQL_RO_USER=atlas_ro
MYSQL_RO_PASSWORD=ropass123
MYSQL_PORTAL_USER=atlas_portal
MYSQL_PORTAL_PASSWORD=portalpass123
